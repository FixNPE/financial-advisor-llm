# Hugging Face access token (required for LLM calls).
# Get one at https://huggingface.co/settings/tokens
HF_TOKEN=hf_...

# Alpha Vantage API key (required for live market data; free tier: 25 req/day, 5/min).
# Get one at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=demo

# LLM provider routed via HF Inference Providers. Use "none" to run fully offline
# on the deterministic rule-based floor (no LLM calls).
LLM_PROVIDER=groq

# Model id routed via HF Inference Providers.
LLM_MODEL_ID=meta-llama/Llama-3.3-70B-Instruct
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# Sentence-transformers embedder used to build the Chroma RAG index.
EMBED_MODEL_ID=BAAI/bge-small-en-v1.5

# Local Chroma vector store location.
CHROMA_DIR=./data/chroma
